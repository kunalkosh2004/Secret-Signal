# =============================================================================
# Secret Signal — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
#
# NEVER commit .env to Git. The .gitignore already excludes it.
#
# Variables prefixed with VITE_ are bundled into the frontend JavaScript
# and must NEVER contain secrets (JWT keys, DB passwords, OAuth secrets).
#
# Generate a secret key: python -c "import secrets; print(secrets.token_urlsafe(64))"
# =============================================================================

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true
LOG_LEVEL=info
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Connection string for the async driver (asyncpg).
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://user:password@host:port/database

# Used by docker-compose to initialize the database container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=secret_signal
POSTGRES_EXTERNAL_PORT=5433

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
REDIS_EXTERNAL_PORT=6379

# ---------------------------------------------------------------------------
# Authentication — JWT
# ---------------------------------------------------------------------------
# SECRET_KEY: Signs JWT tokens. Keep this secret.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# Google OAuth (optional — required for Google login)
# ---------------------------------------------------------------------------
# Values from Google Cloud Console > APIs & Services > Credentials.
# These are BACKEND-ONLY secrets. Never expose to frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_LINK_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/link/callback

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Used by the backend for CORS and redirects.
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Vite-exposed variables (bundled into browser JS — no secrets).
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Docker port overrides
BACKEND_EXTERNAL_PORT=8000
FRONTEND_EXTERNAL_PORT=3000

# ---------------------------------------------------------------------------
# Observability (future)
# ---------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# GRAFANA_PASSWORD=admin

# ---------------------------------------------------------------------------
# Deployment (future — set per environment)
# ---------------------------------------------------------------------------
# RAILWAY_TOKEN=
# VERCEL_TOKEN=
# NEON_API_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
