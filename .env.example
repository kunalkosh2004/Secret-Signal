# Environment Variables
# Copy this file to .env and fill in the values
#
# IMPORTANT: Never commit the .env file to Git.
# Variables prefixed with VITE_ are bundled into the frontend code
# and must NOT contain secrets (Google client secret, JWT secret, etc.)


# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/secret_signal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=secret_signal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Authentication — JWT
# ---------------------------------------------------------------------------
# SECRET_KEY: A long, random string used to sign JWT tokens.
#   Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
#   Keep this secret. Never commit it. Never expose it to the frontend.
SECRET_KEY=RaBbmulLabdWENGXsquvTNVQCl0tJVd-b0YInJCZ2OzJ8r5XS_B1QAYi3CSNPmp62135DWd5C05u92zXHOEjrw
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# Google OAuth (required for Google login)
# ---------------------------------------------------------------------------
# These values come from the Google Cloud Console > APIs & Services > Credentials
#
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are BACKEND-ONLY secrets.
# Never expose them in Vite environment variables or frontend code.
#
# GOOGLE_REDIRECT_URI must match exactly what is configured in Google Cloud Console.
#   For local development: http://localhost:8000/api/v1/auth/google/callback
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Used by the backend to determine the frontend origin for CORS and redirects.
FRONTEND_URL=http://localhost:5173

# Vite-exposed variables (prefixed with VITE_ are bundled into the browser)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
